<div class="max-w-4xl mx-auto px-6 py-12">
  <!-- Header -->
  <div class="mb-12">
    <h1 class="text-4xl font-bold text-[var(--ma-color-text)] mb-3">
      🎉 GemTemplate Engine
    </h1>
    <p class="text-lg text-[var(--ma-color-muted)]">
      Your Rails mountable engine is running successfully!
    </p>
  </div>

  <!-- Grid of Cards -->
  <div class="grid gap-6 mb-6">
    <!-- What's Working Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold text-[var(--ma-color-text)]">
          ✅ What's Working
        </h2>
      <% end %>

      <% card.body do %>
        <ul class="space-y-2.5 text-sm text-[var(--ma-color-text)]">
          <li class="flex items-start">
            <span class="text-green-600 mr-2">✓</span>
            Rails Engine mounted and operational
          </li>
          <li class="flex items-start">
            <span class="text-green-600 mr-2">✓</span>
            PostgreSQL with UUID primary keys
          </li>
          <li class="flex items-start">
            <span class="text-green-600 mr-2">✓</span>
            TailwindCSS styling (Auto rebuilds. See below)
          </li>
          <li class="flex items-start">
            <span class="text-green-600 mr-2">✓</span>
            Codespace environment automatically setups dummy app on build
          </li>
        </ul>
      <% end %>
    <% end %>

    <!-- Rename Your Gem Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold text-[var(--ma-color-text)]">
          🚀 Next Steps: Rename Your Gem
        </h2>
      <% end %>

      <% card.body do %>
        <ul class="space-y-2.5 text-sm text-[var(--ma-color-text)]">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>This gem is currently named <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">gem_template</code></span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Run <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">bin/rename_gem your_gem_name</code> to rename it</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Or ask AI: <em class="text-[var(--ma-color-muted)]">"Rename this gem to my_engine using the rename script"</em></span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>See <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">docs/RENAMING.md</code> for details</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Verify: run tests and check the dummy app starts</span>
          </li>
        </ul>
      <% end %>
    <% end %>

    <!-- Tailwind CSS Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold text-[var(--ma-color-text)]">
          🎨 Tailwind CSS
        </h2>
      <% end %>

      <% card.body do %>
        <ul class="space-y-2.5 text-sm text-[var(--ma-color-text)]">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>CSS is prebuilt when Codespaces starts</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Tailwind auto-rebuilds if you start the server with <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">cd test/dummy && bin/dev</code> (See test/dummy/Procfile.dev)</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>In production, the parent app's Tailwind build compiles the gem's styles — run <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">rails g gem_template:install</code> to automatically add the gem's view paths to the parent's Tailwind config</span>
          </li>
        </ul>
      <% end %>
    <% end %>

    <!-- Style Guide - FlatPack Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold text-[var(--ma-color-text)]">
          💄 UI Components - FlatPack
        </h2>
      <% end %>

      <% card.body do %>
        <p class="text-sm text-[var(--ma-color-text)] mb-4">
          This template includes the <strong>FlatPack</strong> gem — a modern Rails 8 UI component library built with ViewComponent, Tailwind CSS, and Hotwire. Features include form components, cards, buttons, tables, and more.
        </p>
        <ul class="space-y-4 text-sm">
          <li class="list-none">
            <p class="font-medium text-[var(--ma-color-text)] mb-1.5">🎨 Customize Your Theme:</p>
            <p class="text-[var(--ma-color-muted)] ml-6">
              FlatPack uses CSS variables for theming. Customize colors, spacing, and design tokens in your application's Tailwind configuration. Changes apply across all components automatically.
            </p>
          </li>
          <li class="list-none">
            <p class="font-medium text-[var(--ma-color-text)] mb-1.5">🌙 Dark Mode Support:</p>
            <p class="text-[var(--ma-color-muted)] ml-6">
              System preference-driven dark mode works out of the box — no toggle required. Components automatically adapt to light and dark themes.
            </p>
          </li>
          <li class="list-none">
            <p class="font-medium text-[var(--ma-color-text)] mb-1.5">🧩 Component Library:</p>
            <p class="text-[var(--ma-color-muted)] ml-6">
              Includes buttons, cards, forms (text, email, password, search inputs), tables, alerts, badges, and more. All components are ViewComponent-based, type-safe, and testable.
            </p>
          </li>
        </ul>
      <% end %>

      <% card.footer(class: "bg-[var(--ma-color-bg-soft)]") do %>
        <a href="https://github.com/bowerbird-app/flatpack" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-[var(--ma-color-brand)] rounded-[var(--ma-radius-md)] hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--ma-color-brand)] transition-opacity">
          View FlatPack Documentation →
        </a>
      <% end %>
    <% end %>

    <!-- Installing in a Rails App Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold text-[var(--ma-color-text)]">
          📦 Installing in a Rails App
        </h2>
      <% end %>

      <% card.body do %>
        <p class="text-sm text-[var(--ma-color-muted)] mb-4">
          This gem includes an install generator to set up everything automatically:
        </p>
        <ol class="space-y-2.5 text-sm text-[var(--ma-color-text)] list-decimal list-inside mb-4">
          <li>Add the gem to your app's <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">Gemfile</code> and run <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">bundle install</code></li>
          <li>Run <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">rails generate gem_template:install</code></li>
        </ol>
        <p class="text-sm font-medium text-[var(--ma-color-text)] mb-2">The generator will:</p>
        <ul class="space-y-2.5 text-sm text-[var(--ma-color-text)]">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Mount the engine at <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">/gem_template</code> in your routes</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Configure Tailwind CSS to include the gem's views (if Tailwind is detected)</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Display post-installation instructions</span>
          </li>
        </ul>
      <% end %>
    <% end %>

    <!-- Template Features Card -->
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <h2 class="text-lg font-semibold text-[var(--ma-color-text)]">
          ⚡ Template Features
        </h2>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm text-[var(--ma-color-text)]">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Rename Script</strong> — Run <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">bin/rename_gem your_gem_name</code> to rename the entire gem (files, classes, modules, and references)</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Engine Hooks</strong> — Customize engine behavior from your host app with lifecycle hooks (<code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">before_initialize</code>, <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">after_initialize</code>), service hooks, and model/controller extensions</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Service Objects</strong> — Business logic encapsulated in services with Result monad pattern for clean success/failure handling</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Install Generator</strong> — Run <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">rails g gem_template:install</code> to mount the engine, create config initializer, and configure Tailwind</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Migrations Generator</strong> — Run <code class="px-2 py-0.5 bg-[var(--ma-color-bg-soft)] text-[var(--ma-color-accent)] rounded-[var(--ma-radius-sm)] text-xs font-mono">rails g gem_template:migrations</code> to copy engine migrations to your host app</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">Configuration DSL</strong> — Simple configuration API with YAML and initializer support</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span><strong class="font-semibold">UUID Primary Keys</strong> — PostgreSQL UUIDs out of the box for all models</span>
          </li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>



